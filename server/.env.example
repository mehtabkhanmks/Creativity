# Antigravity Server Environment Variables
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=antigravity_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database & Storage
DB_PATH=./database.sqlite
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Real Gmail SMTP service for 6-digit verification codes
# (If left empty, verification code will log directly to console and preview toast)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
